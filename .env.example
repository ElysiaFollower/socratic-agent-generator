# Google gemini
GOOGLE_API_KEY="your_api_key"

# Deepseek
DEEPSEEK_API_KEY="your_api_key"

# OpenAI
OPENAI_API_KEY="your_api_key"

# GLM
GLM_API_KEY="your_api_key"

# MiniMax
MINIMAX_API_KEY="your_api_key"

# LLM defaults
DEFAULT_LLM_PROVIDER="deepseek"

# API key encryption (optional)
LLM_API_KEY_ENCRYPTION_KEY="your_fernet_key"

# API Server configuration for backend
API_HOST = "127.0.0.1"
API_PORT = 8000
CORS_ALLOWED_ORIGINS = "http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:5173" # split by comma

MAX_HISTORY_TOKENS = 100000 # only estimation

ADMIN_TOKEN=Seele
JWT_SECRET_KEY=secret-jwt-key  # python -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared embedding provider for Socratic document RAG and DreamingRAG memory.
EMBEDDING_PROVIDER="volcengine"
VOLCENGINE_API_KEY="your_api_key"
VOLCENGINE_EMBEDDING_MODEL="doubao-embedding-text-240515"
VOLCENGINE_EMBEDDING_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
EMBEDDING_REQUEST_TIMEOUT=60

# HuggingFace is an explicit fallback only:
# EMBEDDING_PROVIDER="huggingface"
HF_MODELS_DIR="models"
HUGGINGFACE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

LANGCHAIN_VERBOSE="true"

# DreamingRAG memory adapter via dreaming_rag.public_api.
# Official deployment installs DreamingRAG by default with:
#   pip install -e ../DreamingRAG
# Enabled by default; set false only for deployments that intentionally run without long-term memory.
DREAMINGRAG_MEMORY_ENABLED="true"
# Defaults to sibling ../DreamingRAG when present; override if needed.
# Real mode requires DreamingRAG in the backend Python env:
# pip install -e /path/to/DreamingRAG
DREAMINGRAG_REPO_PATH="/path/to/your/DreamingRAG"
DREAMINGRAG_MEMORY_MOCK_MODE="false"
DREAMINGRAG_MEMORY_ENABLE_CUE_RECALL="true"
DREAMINGRAG_MEMORY_TOP_N=3
DREAMINGRAG_MEMORY_CONTEXT_CHARS=2000

# DreamingRAG real mode uses the shared Volcengine embedding settings above.

# Remote Runner tool adapter prototype (local/fake tests first; real SSH is opt-in later)
REMOTE_TOOL_ENABLED="false"
# Defaults to sibling ../SEEDRunner when present; override if deployed elsewhere.
REMOTE_RUNNER_REPO_PATH="/path/to/your/SEEDRunner"
# Optional isolated Remote Runner state directory. Do not commit this directory.
REMOTE_RUNNER_STATE_DIR=""
REMOTE_TOOL_COMMAND_TIMEOUT=20
REMOTE_TOOL_OUTPUT_CHARS=4000
# Empty means all configured machines are visible. Set comma-separated ids for production.
REMOTE_TOOL_ALLOWED_MACHINE_IDS=""
# Exact diagnostic commands allowed for session_exec.
REMOTE_TOOL_ALLOWED_COMMANDS="pwd,ls,ls -la,whoami,hostname,uname -a,id,ip addr,ip route,ifconfig,cat /etc/os-release,python --version,python3 --version"
# Optional comma-separated cwd prefixes for session_exec cwd overrides.
REMOTE_TOOL_ALLOWED_CWD_PREFIXES=""
